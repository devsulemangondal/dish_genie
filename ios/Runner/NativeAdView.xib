                <constraint firstItem="body-view" firstAttribute="top" secondItem="headline-view" secondAttribute="bottom" constant="4" id="c7"/>
                <constraint firstItem="headline-view" firstAttribute="trailing" secondItem="body-view" secondAttribute="trailing" id="c8"/>
                <constraint firstItem="media-view" firstAttribute="leading" secondItem="nativeAdView" secondAttribute="leading" constant="12" id="c9"/>
                <constraint firstItem="media-view" firstAttribute="top" secondItem="body-view" secondAttribute="bottom" constant="6" id="c10"/>
                <constraint firstItem="cta-view" firstAttribute="centerY" secondItem="media-view" secondAttribute="centerY" id="c11"/>
                <constraint firstItem="nativeAdView" firstAttribute="trailing" secondItem="cta-view" secondAttribute="trailing" constant="12" id="c12"/>
